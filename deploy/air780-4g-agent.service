[Unit]
Description=Air780 4G network switch
After=NetworkManager.service systemd-networkd.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/air780-4g-agent.py
Restart=on-failure
RuntimeDirectory=air780-4g
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/etc/systemd/network -/etc/NetworkManager/system-connections /run/air780-4g

[Install]
WantedBy=multi-user.target
